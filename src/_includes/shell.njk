<!doctype html>
<html lang="en">
<head>
{% include "head.njk" %}
<link rel="stylesheet" href="{{ '/assets/css/shell.css' | url }}">
</head>
<body class="shell">

{#- Every page in this unit, in reading order. In the sidebar a page shows
    navLabel if set ("Overview" for order 0, else its title); the breadcrumb
    shows "Part N · Title" and the Next button "Part N · navLabel". -#}
{%- set pages = collections.all | unitPages(module.key) %}
{%- set single = pages.length == 1 %}
{%- macro short(p) %}{% if p.data.navLabel %}{{ p.data.navLabel }}{% elif p.data.order == 0 %}Overview{% else %}{{ p.data.title }}{% endif %}{% endmacro %}
{%- macro long(p) %}{% if p.data.order == 0 %}{{ short(p) }}{% else %}Part {{ p.data.order }} · {{ short(p) }}{% endif %}{% endmacro %}

<aside class="sidebar" id="sidebar">
  <div class="side-top">
    <a class="backlink" href="{{ '/' | url }}">← All modules</a>
    <p class="modtitle">{{ module.title }}</p>
  </div>
  {%- if single %}
  <ul class="side-secs single" data-secs></ul>
  {%- else %}
  <ul class="side-parts">
  {%- for p in pages %}
    <li{% if p.url == page.url %} class="current"{% endif %} data-part="{{ p.url | url }}">
      <a class="part-link" href="{{ p.url | url }}">
        <span class="pnum">{{ p.data.order }}</span>
        <span class="ptitle">{{ short(p) }}</span>
      </a>
      {%- if p.url == page.url %}
      <ul class="side-secs" data-secs></ul>
      {%- endif %}
    </li>
  {%- endfor %}
  </ul>
  {%- endif %}
</aside>

<div class="content">
  <div class="topbar">
    <button class="menu-btn" type="button" data-menu aria-label="Open module menu">☰ Menu</button>
    <nav class="crumbs" aria-label="Breadcrumb">
      <a class="root" href="{{ '/' | url }}">{{ site.name }}</a><span class="sep">›</span>
      {%- if not single %}
      <a href="{{ module.url | url }}">{{ module.label }}</a><span class="sep">›</span>
      {%- endif %}
      <span class="here">{% if order == 0 %}{% if navLabel %}{{ navLabel }}{% else %}Overview{% endif %}{% else %}Part {{ order }} · {{ title }}{% endif %}</span>
    </nav>
    {% include "theme-toggle.njk" %}
  </div>
  <div class="scrim" data-scrim></div>

  {%- set adj = pages | adjacent(page.url) %}
  <main
    {% if adj.prev %}data-prev-url="{{ adj.prev.url | url }}" data-prev-label="{{ short(adj.prev) }}"{% endif %}
    {% if adj.next %}data-next-url="{{ adj.next.url | url }}" data-next-label="{{ long(adj.next) }}"{% endif %}
    data-home-url="{{ '/' | url }}"
    data-module-url="{{ module.url | url }}"
    data-module-label="{{ module.label }}">
    <div class="pagecol">
      <div class="parthead"><h1 data-heading>{{ title }}</h1></div>
      <div class="lesson-body" data-content>
{{ content | safe }}
      </div>
      <nav class="secnav" data-secnav hidden>
        <a class="navbtn" data-back></a>
        <span class="pos" data-pos></span>
        <span class="spacer"></span>
        <a class="navbtn primary" data-fwd></a>
      </nav>
    </div>
  </main>
</div>

<script src="{{ '/assets/js/shell.js' | url }}"></script>
{% include "scripts.njk" %}
</body>
</html>
