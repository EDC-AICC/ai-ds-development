<!doctype html>
<html lang="en">
<head>
{% include "head.njk" %}
</head>
<body>

{% include "theme-toggle.njk" %}

<header class="masthead">
  <div class="col">
    {% if kicker %}<p class="kicker">{{ kicker }}</p>{% endif %}
    <h1>{{ title }}</h1>
    {% if standfirst %}<p class="standfirst">{{ standfirst }}</p>{% endif %}
  </div>
</header>

<main>
  <div class="col">
    {{ content | safe }}
  </div>
</main>

<footer class="endcap">
  <div class="col">
    <p>{{ site.footer }}</p>
  </div>
</footer>

{% include "scripts.njk" %}
</body>
</html>
